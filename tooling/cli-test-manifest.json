{
  "schema_version": 1,
  "tools": [
    {
      "name": "filekit",
      "language": "typescript",
      "path": "apps/filekit",
      "os": "ubuntu-latest",
      "build_command": "cd apps/filekit && npm ci && npm run build",
      "unit_command": "cd apps/filekit && npm ci && npm test",
      "smoke_command": "node apps/filekit/dist/index.js --help",
      "integration_command": "./scripts/cli/integration/filekit.sh",
      "release_smoke_command": "cd apps/filekit && npm ci && npm run build && node dist/index.js --help",
      "allows_network_integration": false,
      "allows_system_integration": false
    },
    {
      "name": "agentkit",
      "language": "typescript",
      "path": "apps/agentkit",
      "os": "ubuntu-latest",
      "build_command": "cd apps/agentkit && npm ci && npm run build",
      "unit_command": null,
      "smoke_command": "node apps/agentkit/dist/index.js --help",
      "integration_command": "./scripts/cli/integration/agentkit.sh",
      "release_smoke_command": "cd apps/agentkit && npm ci && npm run build && node dist/index.js --help",
      "allows_network_integration": false,
      "allows_system_integration": false
    },
    {
      "name": "xkit",
      "language": "go",
      "path": "apps/xkit",
      "os": "ubuntu-latest",
      "build_command": "cd apps/xkit && go build -o ../../target/xkit .",
      "unit_command": "cd apps/xkit && go test ./...",
      "smoke_command": "./target/xkit --help && ./target/xkit version",
      "integration_command": "./scripts/cli/integration/xkit.sh",
      "release_smoke_command": "cd apps/xkit && go build -o ../../target/xkit-release . && ../../target/xkit-release --help && ../../target/xkit-release version",
      "allows_network_integration": false,
      "allows_system_integration": false
    },
    {
      "name": "mediakit",
      "language": "swift",
      "path": "apps/mediakit",
      "os": "macos-26",
      "build_command": "./scripts/swift-package-clean-run.sh apps/mediakit swift build",
      "unit_command": null,
      "smoke_command": "./apps/mediakit/.build/debug/mediakit --help",
      "integration_command": "./scripts/cli/integration/mediakit.sh",
      "release_smoke_command": "./scripts/swift-package-clean-run.sh apps/mediakit swift build -c release && ./apps/mediakit/.build/release/mediakit --help",
      "allows_network_integration": false,
      "allows_system_integration": false
    },
    {
      "name": "imagekit",
      "language": "bun",
      "path": "apps/imagekit",
      "os": "macos-26",
      "build_command": "cd apps/imagekit && bun install --frozen-lockfile && bun run build:test",
      "unit_command": "cd apps/imagekit && bun install --frozen-lockfile && bun run typecheck && bun run test",
      "smoke_command": "./apps/imagekit/.test-bin/imagekit --help && ./apps/imagekit/.test-bin/imagekit --version",
      "integration_command": "./scripts/cli/integration/imagekit.sh",
      "release_smoke_command": "cd apps/imagekit && bun install --frozen-lockfile && bun run build:npm && node dist/imagekit.js --help",
      "allows_network_integration": false,
      "allows_system_integration": false
    }
  ]
}
