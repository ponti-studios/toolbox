{
  "name": "@hackefeller/monotone",
  "version": "0.1.2",
  "description": "Content pipeline CLI — rewrite, extract, and queue essays",
  "type": "module",
  "bin": {
    "monotone": "bin/monotone.js"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "files": [
    "bin",
    ".env.example",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "bun build src/index.ts --outfile bin/monotone.js --target node && node --input-type=commonjs -e \"var f=require('fs'),p='bin/monotone.js',c=f.readFileSync(p,'utf8');f.writeFileSync(p,c.replace(/^#!.*$/m,'#!/usr/bin/env node'))\"",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponti-studios/toolbox.git",
    "directory": "apps/monotone"
  },
  "keywords": [
    "content",
    "pipeline",
    "essay",
    "rewrite",
    "monotone"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "commander": "^15.0.0"
  }
}
