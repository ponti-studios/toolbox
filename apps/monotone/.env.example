# Typefully API key (required for `monotone queue`)
# Get yours at https://typefully.com/settings/api
TYPEFULLY_API_KEY=

# Typefully social set ID (required for `monotone queue`)
# Find it with: curl -H "Authorization: Bearer $TYPEFULLY_API_KEY" https://api.typefully.com/v2/social-sets
TYPEFULLY_SOCIAL_SET_ID=

# Ollama URL (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Default model (default: gemma4:e2b-mlx)
MODEL=gemma4:e2b-mlx
