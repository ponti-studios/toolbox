{
  "name": "@ponti-studios/iconkit",
  "version": "1.0.0",
  "description": "Image asset toolkit — resize, optimize, crop, convert, strip metadata, and generate web icons from the command line",
  "type": "module",
  "bin": {
    "iconkit": "dist/iconkit.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile iconkit",
    "build:test": "bun build src/index.ts --compile --outfile .test-bin/iconkit",
    "build:npm": "bun build src/index.ts --target node --outfile dist/iconkit.js",
    "typecheck": "tsc --noEmit",
    "test": "bun run build:test && bun test",
    "prepublishOnly": "bun run build:npm"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponti-studios/toolbox.git",
    "directory": "apps/iconkit"
  },
  "keywords": [
    "image",
    "resize",
    "optimize",
    "webp",
    "avif",
    "favicon",
    "cli",
    "sips"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.13.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "commander": "^13.1.0"
  }
}
