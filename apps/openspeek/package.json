{
  "name": "@ponti-studios/openspeek",
  "version": "0.1.0",
  "description": "Convert Markdown to an AAC/M4A narration using OpenRouter neural TTS (Deepgram Flux / Gemini), with local piper and macOS say fallbacks",
  "keywords": [
    "audiobook",
    "cli",
    "deepgram",
    "flux",
    "markdown",
    "narration",
    "openrouter",
    "text-to-speech",
    "tts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponti-studios/toolbox.git",
    "directory": "apps/openspeek"
  },
  "bin": {
    "openspeek": "dist/openspeek.js"
  },
  "files": [
    "dist",
    "samples",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outfile dist/openspeek.js --target node && node --input-type=commonjs -e \"var f=require('fs'),p='dist/openspeek.js',c=f.readFileSync(p,'utf8');f.writeFileSync(p,c.replace(/^#!.*$/m,'#!/usr/bin/env node'))\"",
    "build:npm": "bun run build",
    "build:binary": "bun build src/index.ts --compile --outfile dist/openspeek",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@tanstack/ai": "^0.45.1",
    "@tanstack/ai-openai": "^0.19.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=24"
  }
}
